{
  "name": "personal-navigation",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 静态资源：public/ 目录原样发布到站点根路径（/、/nav.html、/css/…、/assets/…）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 原 Pages 行为：/nav.html、/status.html 按字面路径直接返回，不做 .html 重写/重定向
    "html_handling": "none",
    // 只有站点根和 /api/* 进入 Worker；/ 由 Worker 映射到 index.html，其余请求由静态资源直接返回
    "run_worker_first": ["/", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
